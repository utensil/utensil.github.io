---
title: Calendar
blog: writings
--- 
-# coding: utf-8
%section.calendar 
  - section_articles.group_by {|a| "#{section_article_date(a).year}年" }.each do |year, year_articles|
    %h2= year
    - year_articles.group_by {|a| "#{section_article_date(a).month}月" }.each do |month, articles|
      %div{:id => "calendar-#{month}" }
        %h3= month
        %ul.listing
          - articles.sort_by { |a| a.source_file }.reverse.each do |article|
            %li.listing-item
              %time{:datetime => section_article_date(article)}=section_article_date(article).strftime('%Y-%m-%d')
              %a{:href => article.url}=article.data.title
