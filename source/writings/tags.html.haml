---
title: Tags
blog: writings
---
-# coding: utf-8
- content_for(:head, stylesheet_link_tag("jqcloud.css"))
- content_for(:scripts, javascript_include_tag("jqcloud-1.0.1.js") + javascript_include_tag("tags.js"))
%section.tags
  #tag_cloud{"data-tags-json" => "/writings/tags.json"}
  - section_tags.each do |tag_and_articles|
    - tag = tag_and_articles[0]
    - articles = tag_and_articles[1]
    %div{:id => "tag-#{tag}" }
      %h2
        = tag
      %ul.listing
        - articles.each do |article|
          .post
            %h2
              %a{:href => article.url}
                =article.data['title']
            %div
              != article_body(article)
          -# %li.listing-item
          -#   %time{:datetime => article.date}=article.date.strftime('%Y-%m-%d')
          -#   %a{:href => article.url}=article.title
            -# %div
            -#   %backquote
            -#     = article.summary
